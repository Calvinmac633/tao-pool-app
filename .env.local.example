SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<your Helius key>
SOLANA_RPC_API_KEY=unused
TRACKED_WALLET=<wallet to snapshot on a timer>
SNAPSHOT_INTERVAL_MINUTES=5
# Optional: password-protect the app (HTTP basic auth). Leave unset for local dev.
APP_PASSWORD=
# Optional: database location. Leave blank for the default local file, data/tracker.db.
# On Fly this is set in fly.toml to the persistent volume.
TRACKER_DB_URL=
